{
  "name": "uep-public-testnet-marketplace",
  "version": "0.3.2-public-security-fix",
  "private": false,
  "type": "module",
  "description": "Public reproducible reference implementation of the UEP local testnet and Digital Services Marketplace.",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test": "npm run test:protocol && npm run test:marketplace",
    "test:protocol": "node --experimental-strip-types --test src/testnet/*.test.ts src/identity/*.test.ts",
    "test:marketplace": "node --experimental-strip-types --test src/marketplace/*.test.ts",
    "smoke:testnet": "node --experimental-strip-types scripts/testnet-smoke.ts",
    "quickstart": "node --experimental-strip-types examples/first-transaction.ts",
    "simulate:20k": "node --experimental-strip-types scripts/marketplace-20k-simulation.mjs",
    "test:scale": "node --experimental-strip-types --test src/marketplace/scale-20k.test.ts",
    "example": "node --experimental-strip-types examples/first-transaction.ts"
  },
  "license": "Apache-2.0"
}
